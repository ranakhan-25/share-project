# Backend API base URL (the imported project pages already use this variable)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5002
# Login endpoint path (appended to API base URL)
NEXT_PUBLIC_LOGIN_PATH=/realbizpro/api/v1/auth/login
# Set to "true" to log in with any identifier + 4 char password (no backend needed)
NEXT_PUBLIC_DEMO_MODE=false
